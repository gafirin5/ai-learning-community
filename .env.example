# AI Learning Community - Environment Variables Template
# Copy this to .env.local and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://oucvzigtxfsdquzhrpwf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Service role key for server-side admin operations
# WARNING: Never expose this in client code!
# SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# LLM / AI TUTOR (server-only, JANGAN pakai prefix NEXT_PUBLIC_)
# ============================================================================
# Endpoint OpenAI-compatible. Key tidak akan terekspos ke browser karena
# dipakai hanya di route handler /api/tutor.
LLM_API_KEY=mk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.kagiro.net/v1
LLM_MODEL=kagiro/qwen3-8max

# ============================================================================
# OPENROUTER API KEY (alternatif provider)
# ============================================================================
# Get free tier at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX  # Google Analytics
# SENTRY_DSN=https://xxxx@sentry.io/xxxx       # Sentry error tracking

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 1. NEVER commit .env.local or .env.production to git!
# 2. On VPS: copy .env.example to .env.production then edit
# 3. Use different keys for dev, staging, production
# 4. Test locally first with .env.local
# 5. Rotate API keys periodically for security
# ============================================================================

